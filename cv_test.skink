// File:    cv_test.skink
// Purpose: Unit tests for skink-cv — image model, PNG/BMP/PPM codec
//          round-trips (in-memory), geometry ops, convolution
//          filters, connected components, Harris corners, and file IO.
module cv_test

import "cv_img"
import "cv_png"
import "cv_bmp"
import "cv_ppm"
import "cv_io"
import "cv_ops"
import "cv_filter"
import "cv_feat"
import "cv"
import "std/str"
import "std/math"
import "std/libc"
import "std/fs"
import "std/testing"

// gradient builds a test RGB image: horizontal gradient + a bright
// square in the middle.
fn gradient(w: int, h: int) -> cv_img.Image {
    im := cv_img.New(w, h, 3)
    for y := 0; y < h; y = y + 1 {
        for x := 0; x < w; x = x + 1 {
            v := float(x) * 255.0 / float(w)
            cv_img.Set(&im, x, y, 0, v)
            cv_img.Set(&im, x, y, 1, float(y) * 255.0 / float(h))
            cv_img.Set(&im, x, y, 2, 128.0)
        }
    }
    // bright square 8..15, 8..15
    for y := 8; y < 16; y = y + 1 {
        for x := 8; x < 16; x = x + 1 {
            cv_img.Set(&im, x, y, 0, 255.0)
            cv_img.Set(&im, x, y, 1, 255.0)
            cv_img.Set(&im, x, y, 2, 255.0)
        }
    }
    return im
}

// TestImageModel verifies allocation/get/set/clone/ToBytes.
pub fn TestImageModel() {
    im := cv_img.New(4, 3, 3)
    cv_img.Set(&im, 2, 1, 0, 200.0)
    testing.AssertTrue(math.Abs(cv_img.Get(&im, 2, 1, 0) - 200.0) < 0.01, "get/set")
    c := cv_img.Clone(&im)
    cv_img.Set(&c, 2, 1, 0, 100.0)
    testing.AssertTrue(math.Abs(cv_img.Get(&im, 2, 1, 0) - 200.0) < 0.01, "clone deep")
    bytes, n := cv_img.ToBytes(&im)
    testing.AssertEqualInt(n, 36, "byte len")
    testing.AssertEqualInt(int(bytes[(1 * 4 + 2) * 3]) & 255, 200, "byte value")
    libc.free(bytes)
}

// TestPNGRoundTrip encodes + decodes in memory, compares pixels.
pub fn TestPNGRoundTrip() {
    src := gradient(24, 16)
    png, n := cv_png.Encode(&src)
    testing.AssertTrue(n > 50, "png produced")
    testing.AssertTrue((int(png[0]) & 255) == 137 && (int(png[1]) & 255) == 80, "png sig")
    d, err := cv_png.Decode(png, n)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("decode: ", err.message))
    testing.AssertEqualInt(d.W, 24, "w")
    testing.AssertEqualInt(d.H, 16, "h")
    testing.AssertEqualInt(d.Channels, 3, "ch")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 10, 10, 0) - 255.0) < 2.0, "square survives")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 0, 0, 2) - 128.0) < 2.0, "blue channel")
    libc.free(png)
}

// TestPNGGray checks 1-channel encode/decode.
pub fn TestPNGGray() {
    src := cv_img.New(8, 8, 1)
    for i := 0; i < 64; i = i + 1 {
        src.Pix[i] = float(i * 4)
    }
    png, n := cv_png.Encode(&src)
    d, err := cv_png.Decode(png, n)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("gray decode: ", err.message))
    testing.AssertEqualInt(d.Channels, 1, "gray ch")
    testing.AssertTrue(math.Abs(d.Pix[10] - 40.0) < 2.0, "gray px")
    libc.free(png)
}

// TestBMPRoundTrip encodes + decodes BMP in memory.
pub fn TestBMPRoundTrip() {
    src := gradient(20, 12)
    bmp, n := cv_bmp.Encode(&src)
    testing.AssertTrue(n > 54, "bmp produced")
    testing.AssertTrue((int(bmp[0]) & 255) == 66, "BM magic")
    d, err := cv_bmp.Decode(bmp, n)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("bmp decode: ", err.message))
    testing.AssertEqualInt(d.W, 20, "w")
    testing.AssertEqualInt(d.H, 12, "h")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 10, 10, 0) - 255.0) < 2.0, "bmp square")
    libc.free(bmp)
}

// TestPPMRoundTrip covers P6 binary round-trip.
pub fn TestPPMRoundTrip() {
    src := gradient(16, 10)
    ppm, n := cv_ppm.Encode(&src)
    d, err := cv_ppm.Decode(ppm, n)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("ppm decode: ", err.message))
    testing.AssertEqualInt(d.W, 16, "w")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 10, 9, 0) - 255.0) < 2.0, "ppm square")
    libc.free(ppm)
}

// TestPPMAscii decodes a hand-written P3.
pub fn TestPPMAscii() {
    src := "P3\n# comment\n2 1\n255\n255 0 0 0 255 0\n"
    d, err := cv_ppm.Decode(src, str.Len(src))
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("p3: ", err.message))
    testing.AssertEqualInt(d.W, 2, "w")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 0, 0, 0) - 255.0) < 1.0, "red px")
    testing.AssertTrue(math.Abs(cv_img.Get(&d, 1, 0, 1) - 255.0) < 1.0, "green px")
}

// TestGeometryOps covers crop/resize/flip/rotate.
pub fn TestGeometryOps() {
    im := gradient(16, 16)
    c := cv_ops.Crop(&im, 8, 8, 8, 8)
    testing.AssertEqualInt(c.W, 8, "crop w")
    testing.AssertTrue(math.Abs(cv_img.Get(&c, 0, 0, 0) - 255.0) < 1.0, "crop content")
    r := cv_ops.ResizeBilinear(&im, 8, 8)
    testing.AssertEqualInt(r.W, 8, "resize w")
    r2 := cv_ops.ResizeNearest(&im, 32, 32)
    testing.AssertEqualInt(r2.W, 32, "up w")
    f := cv_ops.FlipH(&im)
    testing.AssertTrue(math.Abs(cv_img.Get(&f, 15, 0, 0) - cv_img.Get(&im, 0, 0, 0)) < 1.0, "flipH")
    rot := cv_ops.Rotate90(&im)
    testing.AssertEqualInt(rot.W, 16, "rot w")
    p := cv_ops.Pad(&im, 4, 0.0)
    testing.AssertEqualInt(p.W, 24, "pad w")
}

// TestFilters verifies blur/sharpen/sobel/threshold/invert.
pub fn TestFilters() {
    im := gradient(24, 24)
    b := cv_filter.BoxBlur(&im, 3)
    testing.AssertEqualInt(b.W, 24, "blur w")
    g := cv_filter.GaussianBlur(&im, 1.5)
    testing.AssertTrue(cv_img.Get(&g, 12, 12, 0) < 255.0, "blur softens")
    s := cv_filter.Sharpen(&im)
    testing.AssertEqualInt(s.W, 24, "sharpen w")
    // Sobel on grayscale: square edges → nonzero gradient at border
    gray := cv_ops.Grayscale(&im)
    e := cv_filter.Sobel(&gray)
    testing.AssertTrue(cv_img.Get(&e, 8, 12, 0) > 100.0, "sobel edge x")
    t := cv_filter.Threshold(&gray, 128.0)
    testing.AssertTrue(cv_img.Get(&t, 10, 10, 0) > 200.0, "thresh bright")
    inv := cv_filter.Invert(&t)
    testing.AssertTrue(cv_img.Get(&inv, 10, 10, 0) < 10.0, "invert")
}

// TestHistogram verifies bins + equalization raises contrast.
pub fn TestHistogram() {
    im := gradient(16, 16)
    gray := cv_ops.Grayscale(&im)
    hist := cv_filter.Histogram(&gray)
    total := 0
    for i := 0; i < 256; i = i + 1 {
        total = total + hist[i]
    }
    testing.AssertEqualInt(total, 256, "hist total")
    eq := cv_filter.Equalize(&gray)
    testing.AssertEqualInt(eq.W, 16, "eq w")
}

// TestComponents labels two blobs and checks their boxes.
pub fn TestComponents() {
    im := cv_img.New(20, 20, 1)
    // blob 1: 2x2 at (3,3)
    for y := 3; y < 5; y = y + 1 {
        for x := 3; x < 5; x = x + 1 {
            cv_img.Set(&im, x, y, 0, 255.0)
        }
    }
    // blob 2: 3x2 at (12,10)
    for y := 10; y < 12; y = y + 1 {
        for x := 12; x < 15; x = x + 1 {
            cv_img.Set(&im, x, y, 0, 255.0)
        }
    }
    _, blobs := cv_feat.Components(&im, 128.0)
    testing.AssertEqualInt(len(blobs), 2, "blob count")
    testing.AssertEqualInt(blobs[0].Area, 4, "blob1 area")
    testing.AssertEqualInt(blobs[1].Area, 6, "blob2 area")
    testing.AssertEqualInt(blobs[0].X, 3, "blob1 x")
    testing.AssertEqualInt(blobs[1].W, 3, "blob2 w")
}

// TestHarris puts a corner in an image and verifies detection.
pub fn TestHarris() {
    im := cv_img.New(24, 24, 1)
    // L-shaped corner at (12,12): bright lower-right quadrant
    for y := 12; y < 24; y = y + 1 {
        for x := 12; x < 24; x = x + 1 {
            cv_img.Set(&im, x, y, 0, 255.0)
        }
    }
    score := cv_feat.HarrisScore(&im, 0.04)
    pts := cv_feat.LocalMaxima(&score, 1000.0, 2)
    testing.AssertTrue(len(pts) > 0, "corners found")
    // at least one corner near (12,12)
    found := false
    for i := 0; i < len(pts); i = i + 1 {
        if math.Abs(float(pts[i].X - 12)) < 4.0 && math.Abs(float(pts[i].Y - 12)) < 4.0 {
            found = true
        }
    }
    testing.AssertTrue(found, "corner near (12,12)")
}

// TestFileIO round-trips through real files.
pub fn TestFileIO() {
    im := gradient(20, 14)
    pngPath := "/tmp/skink-cv-test.png"
    werr := cv_io.SavePNG(pngPath, &im)
    testing.AssertTrue(str.Len(werr.message) == 0, "save png")
    d, rerr := cv_io.Load(pngPath)
    testing.AssertTrue(str.Len(rerr.message) == 0, str.Concat("load png: ", rerr.message))
    testing.AssertEqualInt(d.W, 20, "loaded w")
    fs.Remove(pngPath)

    ppmPath := "/tmp/skink-cv-test.ppm"
    werr2 := cv_io.Save(ppmPath, &im)
    testing.AssertTrue(str.Len(werr2.message) == 0, "save ppm")
    d2, rerr2 := cv_io.Load(ppmPath)
    testing.AssertTrue(str.Len(rerr2.message) == 0, "load ppm")
    testing.AssertEqualInt(d2.H, 14, "ppm h")
    fs.Remove(ppmPath)
}

// TestRootWrappers exercises the cv.* convenience functions.
pub fn TestRootWrappers() {
    im := cv.NewImage(8, 8, 3)
    g := cv.Grayscale(&im)
    testing.AssertEqualInt(g.Channels, 1, "gray")
    r := cv.Resize(&im, 4, 4)
    testing.AssertEqualInt(r.W, 4, "resize")
    e := cv.Edges(&im)
    testing.AssertEqualInt(e.Channels, 1, "edges")
    bl := cv.Blur(&im, 1.0)
    testing.AssertEqualInt(bl.W, 8, "blur")
}
