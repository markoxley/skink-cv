// File:    cv_ppm.skink
// Purpose: Netpbm codec for skink-cv. Decode handles binary P6 (PPM)
//          and P5 (PGM) plus ASCII P3/P2; comments and arbitrary
//          whitespace are skipped per spec. Encode writes P6/P5.
module cv_ppm

import "std/str"
import "std/errors"
import "std/libc"
import "cv_img"

// Raw byte accessor for the binary P6/P5 raster — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int

// token reads the next whitespace/comment-separated token; returns the
// token and the offset just past it.
fn token(data: string, n: int, pos: int) -> (string, int) {
    i := pos
    // skip whitespace + comments
    for i < n {
        c := Skink_mem_byte(data, int64(i)) & 255
        if c == 35 {   // '#' comment to EOL
            for i < n && Skink_mem_byte(data, int64(i)) != 10 {
                i = i + 1
            }
        } else if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    start := i
    for i < n {
        c := Skink_mem_byte(data, int64(i)) & 255
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 35 {
            break
        }
        i = i + 1
    }
    return str.Substr(data, start, i - start), i
}

fn atoi(s: string) -> int {
    v := 0
    for i := 0; i < str.Len(s); i = i + 1 {
        c := int(s[i])
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + c - 48
    }
    return v
}

// Decode parses a P6/P5/P3/P2 Netpbm image.
pub fn Decode(data: string, byteLen: int) -> (cv_img.Image, errors.Error) {
    var empty cv_img.Image
    if byteLen < 2 || (Skink_mem_byte(data, int64(0)) & 255) != 80 {
        return empty, errors.New("ppm: bad magic")
    }
    kind := Skink_mem_byte(data, int64(1)) - 48
    if kind != 2 && kind != 3 && kind != 5 && kind != 6 {
        return empty, errors.New("ppm: unsupported variant (need P2/P3/P5/P6)")
    }
    wS, p1 := token(data, byteLen, 2)
    hS, p2 := token(data, byteLen, p1)
    mS, p3 := token(data, byteLen, p2)
    w := atoi(wS)
    h := atoi(hS)
    maxv := atoi(mS)
    if w <= 0 || h <= 0 || maxv <= 0 {
        return empty, errors.New("ppm: bad header")
    }
    if kind == 6 || kind == 5 {
        // binary: single whitespace after maxval, then raw bytes
        p3 = p3 + 1
        ch := 3
        if kind == 5 {
            ch = 1
        }
        if p3 + w * h * ch > byteLen {
            return empty, errors.New("ppm: truncated raster")
        }
        im := cv_img.FromBytes(w, h, ch, string(int64(data) + int64(p3)), w * h * ch)
        if maxv != 255 {
            for i := 0; i < len(im.Pix); i = i + 1 {
                im.Pix[i] = im.Pix[i] * 255.0 / float(maxv)
            }
        }
        return im, errors.New("")
    }
    // ASCII variants
    ch := 3
    if kind == 2 {
        ch = 1
    }
    im := cv_img.New(w, h, ch)
    pos := p3
    for i := 0; i < w * h * ch; i = i + 1 {
        var t string
        t, pos = token(data, byteLen, pos)
        im.Pix[i] = float(atoi(t)) * 255.0 / float(maxv)
    }
    return im, errors.New("")
}

// Encode writes a P6 (3ch) or P5 (1ch) image (malloc'd — caller frees).
pub fn Encode(im: *cv_img.Image) -> (string, int) {
    hdr := "P6 "
    if im.Channels == 1 {
        hdr = "P5 "
    }
    hdr = str.Concat(hdr, itoa(im.W))
    hdr = str.Concat(hdr, " ")
    hdr = str.Concat(hdr, itoa(im.H))
    hdr = str.Concat(hdr, " 255\n")
    hl := str.Len(hdr)
    pixLen := im.W * im.H * im.Channels
    out := libc.malloc(hl + pixLen)
    libc.memcpy(out, hdr, hl)
    bytes, _ := cv_img.ToBytes(im)
    libc.memcpy(string(int64(out) + int64(hl)), bytes, pixLen)
    libc.free(bytes)
    return out, hl + pixLen
}

// itoa renders a non-negative int.
fn itoa(v: int) -> string {
    if v == 0 {
        return "0"
    }
    s := ""
    for v > 0 {
        d := v % 10
        s = str.Concat(str.Substr("0123456789", d, 1), s)
        v = v / 10
    }
    return s
}
